{
  "name": "Healthcare IoT Testbed Dev",
  "dockerComposeFile": "docker-compose.yaml",
  "service": "devcontainer",
  "workspaceFolder": "/workspaces/Healthcare-IoT-Testbed",

  "features": {
    "ghcr.io/devcontainers/features/aws-cli:1": {},
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.14"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installOhMyZsh": false,
      "configureZshAsDefaultShell": false
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "hashicorp.terraform",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "amazonwebservices.aws-toolkit-vscode",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "dbaeumer.vscode-eslint",
        "github.vscode-github-actions"
      ]
    }
  },

  "containerEnv": {
    "AWS_CONFIG_FILE": "${containerWorkspaceFolder}/.devcontainer/aws/config",
    "AWS_PROFILE": "Healthcare-IoT-Dev",
    // Host X server (XWayland on Hyprland, WSLg on Windows). Must be non-empty on the host.
    "DISPLAY": "${localEnv:DISPLAY}",
    "XDG_RUNTIME_DIR": "/tmp"
  },

  "mounts": [
    // X11 socket only. Works on CachyOS/Hyprland (XWayland) and WSL (WSLg).
    // Run `xhost +local:` on the host first so the container can connect.
    // Do NOT bind the Wayland socket or /mnt/wslg here: a missing source path
    // makes the container fail to start, and an empty WAYLAND_DISPLAY would
    // bind your whole XDG_RUNTIME_DIR over /tmp. Put those in a per-machine override.
    "type=bind,source=/tmp/.X11-unix,target=/tmp/.X11-unix"
  ],

  // Local_GUI needs: Xephyr, xwininfo/xprop (x11-utils), matchbox-window-manager,
  // libX11 (ctypes), tkinter (tk), and Pillow (ImageTk).
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y jq curl xserver-xephyr x11-utils matchbox-window-manager libx11-6 tk && pip install --upgrade pip pillow && cd ${containerWorkspaceFolder}/Platform/services/web && npm install",

  "remoteUser": "vscode"
}

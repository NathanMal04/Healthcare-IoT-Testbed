# Copy to terraform.tfvars (git-ignored) and fill in. CI doesn't read this
# file: it gets the same values as TF_VAR_* from GitHub repository variables
# (SELF_HOSTING.md).

aws_region = "us-east-2"

# Prefix for every resource name. S3 bucket names derive from it
# (<name>-web, <name>-data-lake), so it must be globally unique. 3-29
# lowercase letters, digits and hyphens.
name = "my-testbed-dev"

# Where the site is served. www.<domain_name> also works and redirects here,
# unless include_www = false.
domain_name = "testbed.example.com"
# include_www = false

# Route 53 hosted zone of domain_name, to have Terraform create the
# certificate validation and site DNS records. Leave unset to add them by
# hand at your DNS provider (terraform output acm_validation_records).
# route53_zone_id = "Z0123456789ABCDEFGHIJ"

# Product name shown in the web app and the sign-up email.
# brand_name = "Vzoniq"

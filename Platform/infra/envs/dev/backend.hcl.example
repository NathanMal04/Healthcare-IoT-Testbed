# Copy to backend.hcl (git-ignored) and run: terraform init -backend-config=backend.hcl
# Platform/scripts/deploy.sh bootstrap writes it for you.
bucket = "my-testbed-tf-state"
key    = "dev/terraform.tfstate"
region = "us-east-2"

# S3-native state locking (Terraform >= 1.10): stops two applies writing the
# state at once. Recommended.
use_lockfile = true

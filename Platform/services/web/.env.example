# Vzoniq web app (Next.js static export) — the only environment variables it reads.
# Copy what you need into .env.local / .env.development.local (both are gitignored).
# CI (deploy-web, frontend-pr-check) sets the NEXT_PUBLIC_* values from Terraform outputs.

# Cognito user pool and app client (terraform output cognito_user_pool_id / cognito_user_pool_client_id).
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-2_XXXXXXXXX
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Base URL of the platform API (terraform output api_invoke_url),
# e.g. https://<api-id>.execute-api.us-east-2.amazonaws.com/dev
#
# Local development: set it to /dev-api and set API_PROXY_TARGET below, so the
# browser makes same-origin requests and the API's vzoniq.com-only CORS policy
# doesn't apply. `next dev` then proxies /dev-api/* to API_PROXY_TARGET.
NEXT_PUBLIC_API_URL=/dev-api

# Development server only (never used by `next build`): where /dev-api/* is proxied.
API_PROXY_TARGET=https://<api-id>.execute-api.us-east-2.amazonaws.com/dev

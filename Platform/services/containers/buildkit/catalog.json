    {
      "id": "ghidra",
      "name": "Ghidra (headless)",
      "description": "Ghidra 11.1.2 with analyzeHeadless on PATH. The platform-ghidra base already includes it.",
      "apt": ["openjdk-17-jre-headless", "wget", "unzip"],
      "run": [
        "wget -q https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_11.1.2_build/ghidra_11.1.2_PUBLIC_20240709.zip -O /tmp/ghidra.zip && unzip -q /tmp/ghidra.zip -d /opt && mv /opt/ghidra_* /opt/ghidra && rm /tmp/ghidra.zip && ln -s /opt/ghidra/support/analyzeHeadless /usr/local/bin/analyzeHeadless"
      ]
    },
    {

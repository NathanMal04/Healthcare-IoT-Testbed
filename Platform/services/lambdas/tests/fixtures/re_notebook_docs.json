    {"name": "mixed-case javascript link", "doc": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "marks": [{"type": "link", "attrs": {"href": "JaVaScRiPt:alert(1)"}}], "text": "x"}]}]}},
    {"name": "data link", "doc": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "marks": [{"type": "link", "attrs": {"href": "data:text/html,<script>alert(1)</script>"}}], "text": "x"}]}]}},
    {"name": "relative link", "doc": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "marks": [{"type": "link", "attrs": {"href": "/devices"}}], "text": "x"}]}]}},
    {"name": "link with leading space", "doc": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "marks": [{"type": "link", "attrs": {"href": " https://x.org"}}], "text": "x"}]}]}},
    {"name": "link without host", "doc": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "marks": [{"type": "link", "attrs": {"href": "https://"}}], "text": "x"}]}]}},
    {"name": "link with extra attributes", "doc": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "marks": [{"type": "link", "attrs": {"href": "https://x.org", "target": "_self"}}], "text": "x"}]}]}},
    {"name": "heading level 4", "doc": {"type": "doc", "content": [{"type": "heading", "attrs": {"level": 4}, "content": [{"type": "text", "text": "x"}]}]}},

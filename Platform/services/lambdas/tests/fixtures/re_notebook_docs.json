    {"name": "empty text node", "doc": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": ""}]}]}},
    {"name": "control character in text", "doc": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "a\u0000b"}]}]}},
    {"name": "marks in a code block", "doc": {"type": "doc", "content": [{"type": "codeBlock", "content": [{"type": "text", "marks": [{"type": "bold"}], "text": "x"}]}]}},
    {"name": "inline code with another mark", "doc": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "marks": [{"type": "bold"}, {"type": "code"}], "text": "x"}]}]}},
    {"name": "the same mark twice", "doc": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "marks": [{"type": "bold"}, {"type": "bold"}], "text": "x"}]}]}},
    {"name": "mark with attributes", "doc": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "marks": [{"type": "bold", "attrs": {"x": 1}}], "text": "x"}]}]}},
    {"name": "list item starting with a heading", "doc": {"type": "doc", "content": [{"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "heading", "attrs": {"level": 2}, "content": [{"type": "text", "text": "x"}]}]}]}]}},
    {"name": "empty list", "doc": {"type": "doc", "content": [{"type": "bulletList", "content": []}]}},
    {"name": "empty quote", "doc": {"type": "doc", "content": [{"type": "blockquote"}]}},
    {"name": "paragraph inside a paragraph", "doc": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "paragraph"}]}]}},
    {"name": "text at the top level", "doc": {"type": "doc", "content": [{"type": "text", "text": "x"}]}},
